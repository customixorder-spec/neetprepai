VITE_FIREBASE_STORAGE_BUCKET="studyai-90705.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Backend URL for Vercel Deployments:
# When hosting frontend on Vercel, requests to OTP & Gemini APIs route to this backend URL
VITE_BACKEND_URL="https://ais-dev-7gu5l537srg7dayufiwsv7-133578617612.asia-southeast1.run.app"

